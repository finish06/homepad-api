# homepad-api runtime configuration
#
# Copy this file to .env for local dev (with docker-compose), or wire each
# variable into the K8s Deployment / ConfigMap / Secret in the platform repo.

# --- core ---
PORT=8080

# --- database (Postgres) ---
# Format: postgres://user:pass@host:5432/dbname?sslmode=disable
DATABASE_URL=postgres://homepad:homepad@localhost:5432/homepad?sslmode=disable

# --- sessions ---
# 32+ random bytes; rotate to force log-out everywhere.
SESSION_SECRET=change-me-to-32-random-bytes

# --- registration policy ---
# Controls whether new accounts can self-register after bootstrap. The first
# account always registers and becomes the admin.
#   invite_only  — only an admin adds accounts, with invite links (default)
#   open         — anyone who can reach Homepad can register
HOMEPAD_REGISTRATION=invite_only

# Caps all accounts (admin, member, kid) plus pending invites. Unset or 0 is
# no limit. A value that isn't a whole number stops the API at startup.
# HOMEPAD_MAX_ACCOUNTS=12

# --- gatus (cluster-internal only — never expose externally) ---
GATUS_BASE_URL=http://gatus.10.17.2.213.nip.io

# --- status widgets ---
# Seals widget keys (Jellyfin, Sonarr, Radarr API keys) at rest with
# AES-256-GCM. 32 bytes as 64 hex characters: `openssl rand -hex 32`.
# Unset: the clock, weather and web search still work, and the API refuses
# to store a widget key. Changing it makes every saved key unreadable; the
# admin enters them again. Never put it in a ConfigMap — it is a secret.
HOMEPAD_SECRET_KEY=

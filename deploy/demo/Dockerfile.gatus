# Gatus for the public demo (demo.gethomepad.dev): checks each demo tile's public
# project URL so the demo shows live health instead of "Status is not being
# checked". Config generated by gen-gatus-config.py; listens on :8082 so it can
# sit beside web and api in the demo's Cloud Run service.
#   docker build -f deploy/demo/Dockerfile.gatus -t <registry>/homepad-demo-gatus .
FROM ghcr.io/twin/gatus:v5.37.0
COPY deploy/demo/gatus.yaml /config/config.yaml
EXPOSE 8082
